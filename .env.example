# Local / demo defaults. Copy to .env and fill — never commit secrets.
# Production checklist is in README.

# --- required in production (boot) ---
# DATABASE_URL=postgres://user:pass@host:5432/softspark
# BETTER_AUTH_SECRET=generate-a-32+-char-secret
# AUTH_SECRET=  # alias of BETTER_AUTH_SECRET

# --- required in production (auth URLs / CORS) ---
# BETTER_AUTH_URL=https://api.example.com
# WEB_ORIGIN=https://app.example.com
# AUTH_MODE=prod

# --- required in production (Places / VenueSuggester) ---
# GOOGLE_PLACES_API_KEY=

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Expo ---
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- optional: LLM soak (stub fallback if key missing) ---
# Rollback: MATCH_ENGINE_MODE=stub (ignores OPENAI_API_KEY; no code change)
MATCH_ENGINE_MODE=stub
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# --- optional: web push (status-only A) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# EXPO_ACCESS_TOKEN=

# --- optional: Partykit ---
# PARTYKIT_HOST=http://127.0.0.1:1999
# PARTYKIT_TOKEN=

# --- local only ---
# PGLITE_DATA_DIR=.data/pglite
# ALLOW_VENUE_SEED=1
# PORT=8787
