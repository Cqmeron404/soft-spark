# Local / demo defaults. Copy to .env and fill — never commit secrets.
# Production checklist is in README.

# --- required in production (boot) ---
# DATABASE_URL=postgres://user:pass@host:5432/softspark
# BETTER_AUTH_SECRET=generate-a-32+-char-secret
# AUTH_SECRET=  # alias of BETTER_AUTH_SECRET

# --- required in production (auth URLs / CORS) ---
# BETTER_AUTH_URL=https://api.example.com
# WEB_ORIGIN=https://app.example.com
# Exact origins, no trailing slash. WEB_ORIGIN is CORS Allow-Origin + Better Auth trustedOrigins.
# Do not set cookie Domain=.vercel.app (public suffix). Cross-site prod cookies are SameSite=None; Secure.
# AUTH_MODE=prod

# --- demo one-tap (Maya / Jordan on web /auth/sign-in) ---
# Production: on by default. Set 0 to disable. Local: set 1 so pnpm dev:api
# seeds the same emails/passwords as the sign-in buttons.
# ALLOW_DEMO_USERS=1

# --- venues (VenueSuggester) ---
# $0 go-live: seed Denver catalog instead of Google Places (Vercel API):
ALLOW_VENUE_SEED=1
# VENUE_MODE=seed
# GOOGLE_PLACES_API_KEY=   # required in prod unless seed; used when set and seed is not forced

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Expo ---
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- optional: LLM soak (stub fallback if key missing) ---
# Rollback / default: MATCH_ENGINE_MODE=stub (ignores OPENAI_API_KEY; no code change)
MATCH_ENGINE_MODE=stub
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# --- optional: web push (status-only A) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# EXPO_ACCESS_TOKEN=

# --- optional: Partykit ---
# PARTYKIT_HOST=http://127.0.0.1:1999
# PARTYKIT_TOKEN=

# --- local only ---
# PGLITE_DATA_DIR=.data/pglite
# PORT=8787
