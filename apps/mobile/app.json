{
  "expo": {
    "name": "Soft Spark",
    "slug": "soft-spark",
    "scheme": "softspark",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/brand/png/soft-spark-mark-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1EA"
    },
    "ios": { "supportsTablet": false },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1EA"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "color": "#E8A598"
        }
      ]
    ]
  }
}
